# Path may be absolute or relative to the directory from which the server runs.
NEWS_MCP_DATABASE_PATH=data/news.db

# MIT News' official artificial-intelligence topic RSS feed.
MIT_NEWS_RSS_URL=https://news.mit.edu/topic/mitartificial-intelligence2-rss.xml
TECHCRUNCH_RSS_URL=https://techcrunch.com/feed/

# Required to enable the official Guardian Open Platform adapter. Never commit this value.
GUARDIAN_API_KEY=

# Option A: leave blank unless DeepLearning.AI provides a permitted, official RSS/Atom endpoint.
DEEPLEARNING_AI_BATCH_RSS_URL=

# The default public archive metadata endpoint and a constrained Google News discovery fallback.
# The Google result must redirect to an official /the-batch/issue-* URL before it is stored.
DEEPLEARNING_AI_BATCH_ARCHIVE_URL=https://www.deeplearning.ai/the-batch
DEEPLEARNING_AI_BATCH_GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search?q=site%3Adeeplearning.ai%2Fthe-batch%2Fissue-%20%22The%20Batch%22&hl=en-US&gl=US&ceid=US%3Aen

# Option B: subscribe to The Batch yourself and grant read-only IMAP access to that inbox.
# Use a mail-provider app password, never your primary mailbox password. Do not set these when
# using Option A. DEEPLEARNING_AI_BATCH_IMAP_FROM must be the actual sender address you receive.
DEEPLEARNING_AI_BATCH_IMAP_HOST=
DEEPLEARNING_AI_BATCH_IMAP_USERNAME=
DEEPLEARNING_AI_BATCH_IMAP_PASSWORD=
DEEPLEARNING_AI_BATCH_IMAP_FROM=
DEEPLEARNING_AI_BATCH_IMAP_MAILBOX=INBOX

# Streamable HTTP listener. Keep 127.0.0.1 for local development.
NEWS_MCP_HOST=127.0.0.1
NEWS_MCP_PORT=8000

# Phase 2, Milestone 1: Telegram bot -> independent MCP server.
# Restrict access with at least one authorized user ID or chat ID. Comma-separate multiple IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
NEWS_BOT_MCP_URL=http://127.0.0.1:8000/mcp
NEWS_BOT_LATEST_LIMIT=5

# Phase 2, Milestone 2: LangChain + LangGraph news agent.
# Keep the API key only in your local .env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

